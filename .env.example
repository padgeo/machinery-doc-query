# Copy this file to .env and fill in real values. .env is gitignored.
#
# Azure OpenAI
# ------------
# AZURE_OPENAI_ENDPOINT is your resource's base URL, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://placeholder.openai.azure.com
AZURE_OPENAI_API_KEY=placeholder
# Azure API version. json_schema structured outputs require 2024-08-01-preview or later.
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# NOTE: these are Azure "deployment names" (chosen by whoever deployed the model in
# Azure AI Studio), NOT the underlying model name (e.g. your deployment might be named
# "embeddings-prod" even though it points at text-embedding-3-small).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=placeholder
# Structured outputs require a deployment on gpt-4o-2024-08-06+, gpt-4.1, or gpt-5 family.
AZURE_OPENAI_CHAT_DEPLOYMENT=placeholder

# Qdrant
# ------
# gRPC endpoint (not the REST/dashboard port). Matches docker-compose.yml's 6334 mapping.
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=placeholder
QDRANT_COLLECTION=machinery_docs

# Must match the output dimensionality of AZURE_OPENAI_EMBEDDING_DEPLOYMENT's model.
# text-embedding-3-small / text-embedding-ada-002 = 1536, text-embedding-3-large = 3072.
EMBEDDING_DIMENSIONS=1536
